  display: flex;
  gap: 8rpx;
}

.mine-banner-dot {
  width: 8rpx;
  height: 8rpx;
  border-radius: 50%;
  background: rgba(255,255,255,0.5);
}

.mine-banner-dot.active {
  background: #fff;
  width: 24rpx;
  border-radius: 4rpx;
}

.mine-orders-card {
  background: #fff;
  margin: 24rpx 24rpx 0;
  border-radius: 24rpx;
  padding: 28rpx;
